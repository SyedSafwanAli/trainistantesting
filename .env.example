# The Apps Script web app URL from the Google Sheet
# (Extensions > Apps Script > Deploy > New deployment > Web app > "Anyone").
VITE_SHEET_URL=

# Must match SHARED_KEY in google-apps-script/Code.gs.
# Not a secret in the security sense: it ships in the bundle. It only stops
# casual noise reaching the sheet from someone who found the URL.
VITE_SHARED_KEY=
